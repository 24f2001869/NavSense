  "synthesis_for_c5_3": {
    "core_finding": "Kinematic drift rate is remarkably uniform across trips at 0.23 to 0.27 m/s\u00b2, producing ~200-230 m position error over 30 s outages. The residual error r(t) is 85-98% time-varying dynamic variance, strongly coupled to vehicle acceleration via chassis suspension pitch squat/dive (negative slope -0.33 to -0.65).",
    "target_formulation_c5_3": "r_hat(t) = a_x_level(t) - a_true(t)",
    "required_dynamic_range_ms2": [
      -6.0,
      6.0
    ],
    "primary_input_signals": [
      "a_x_level (longitudinal measured specific force)",
      "accel_mag (total acceleration norm)",
      "gyro_norm (total angular rate)",
      "vibration_std (road roughness indicator)",
      "temporal history / derivative (pitch transient indicator)"
    ]
  }
