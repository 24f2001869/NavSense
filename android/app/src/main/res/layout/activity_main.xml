<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 1. Header & Navigation State Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE FIELD DIAGNOSTICS + NAV"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_trip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-Device Field Observer"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_nav_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_gnss_locked"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="GNSS 3D FIX"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Local OSM Road Map View (Vector ENU) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <com.sih26168.idr.ui.LocalRoadMapView
                android:id="@+id/road_map_view"
                android:layout_width="match_parent"
                android:layout_height="210dp" />

            <!-- Geodetic Coordinates Readout below map -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_gnss_lat_lon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GNSS: 17.445210°, 78.349120°"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tv_gnss_accuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACC: ±3.0 m"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Direct Side-by-Side Speed Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED COMPARISON (GROUND TRUTH VS CAUSAL ML)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left: GNSS Measured Speed -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GNSS MEASURED"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_gnss_speed_kmh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/accent_cyan"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_gnss_speed_ms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 m/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/hud_card_stroke"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Right: Causal ML Speed -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAUSAL ML SPEED"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_speed_kmh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/accent_amber"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_speed_ms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 m/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Error Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#152238"
                android:padding="6dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED ERROR (GNSS - ML): "
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_speed_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 km/h"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Heading & Compass Display with Course Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.sih26168.idr.ui.CompassRoseView
                    android:id="@+id/compass_view"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEHICLE NAV HEADING"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_heading_deg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="000.0°"
                        android:textColor="@color/accent_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_heading_cardinal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NORTH"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_heading_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOURCE: 15-STATE ESKF"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />

                    <!-- Course vs Heading Comparison -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/hud_card_stroke"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_gnss_course"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GNSS COURSE: --"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_filter_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FILTER HEADING: 000.0°"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_heading_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Δ: --"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_mag_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAGNETIC: 000.0°"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Phone Tilt / Attitude & Altitude / Vertical Motion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- Phone Attitude (Artificial Horizon) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginEnd="4dp">

                <com.sih26168.idr.ui.AttitudeHorizonView
                    android:id="@+id/horizon_view"
                    android:layout_width="match_parent"
                    android:layout_height="110dp" />

                <TextView
                    android:id="@+id/tv_phone_attitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R: +0.0° | P: +0.0°"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:typeface="monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Altitude & Vertical Motion -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALTITUDE / VERTICAL"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gnss_alt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS ALT: --"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_filter_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL ΔUP: +0.0 m"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_vert_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERT SPEED: +0.00 m/s"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_vertical_drift_warn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠ VERTICAL DRIFT"
                    android:textColor="@color/accent_coral"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#33FF5252"
                    android:padding="3dp"
                    android:visibility="gone"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 6. Compact Live Sensor Health & Measured Timing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SENSOR HEALTH &amp; MEASURED RATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sensor_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RATE: -- Hz | Δt: -- ms"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- 4-Chip Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tile_sensor_accel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="5dp"
                    android:gravity="center"
                    android:text="ACCEL | OK"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/tile_sensor_gyro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="5dp"
                    android:gravity="center"
                    android:text="GYRO | OK"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/tile_sensor_mag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="5dp"
                    android:gravity="center"
                    android:text="MAG | OK"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/tile_sensor_gnss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="5dp"
                    android:gravity="center"
                    android:text="GNSS | OK"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Norms Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_norm_accel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acc: 9.81 m/s²"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_norm_gyro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gyro: 0.00 °/s"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_norm_mag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mag: 45.0 µT"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 7. Inertial Constraints & Trust Status (with rejection reasons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INERTIAL CONSTRAINTS &amp; QUALITY GATES"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: NHC and VNHC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tile_nhc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="6dp"
                    android:gravity="center"
                    android:text="LATERAL NHC: INACTIVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tile_vnhc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="6dp"
                    android:gravity="center"
                    android:text="VERTICAL NHC: INACTIVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Row 2: Compass and OSM Guidance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tile_compass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="6dp"
                    android:gravity="center"
                    android:text="COMPASS: ACCEPTED"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tile_osm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_gnss_locked"
                    android:padding="6dp"
                    android:gravity="center"
                    android:text="OSM MAP: ACCEPTED"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Pre-outage Causal Biases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bias_accel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Accel Bias b_ax: 0.00 m/s²"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_bias_gyro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ZARU Gyro b_gz: 0.00°/s"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 8. Local Cartesian ENU Position & Outage Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL CARTESIAN ENU ESTIMATE (METERS FROM START FIX)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_pos_sigma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±1.50 m"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EAST (E)"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_pos_e"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0.0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NORTH (N)"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_pos_n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0.0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UP (U)"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_pos_u"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0.0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTAGE TIMER"
                        android:textColor="@color/text_dim"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_outage_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 s"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 9. Mode A Replay Button -->
        <Button
            android:id="@+id/btn_replay_demo"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/btn_demo_bg"
            android:text="▶  START 60s BLACKOUT REPLAY DEMO (MODE A)"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <!-- 10. Mode B Field Actions: Logging & Outage Simulation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_record_log"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:text="🔴 START LOGGING"
                android:textColor="@color/accent_coral"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_toggle_outage"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:text="⚡ SOFTWARE BLACKOUT"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Logging Status & Saved File Path Readout -->
        <TextView
            android:id="@+id/tv_log_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor Logger: IDLE • Ready for field validation"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <!-- 11. Stage C11: Controlled Calibration Dataset Logger (High-Rate Raw IMU + Monotonic Clock) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STAGE C11: CONTROLLED CALIBRATION RECORDER"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_active_marker_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_gnss_locked"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="NORMAL"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_record_raw_calibration"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/card_bg"
                android:text="🔴 START RAW CALIBRATION LOG (100 Hz)"
                android:textColor="@color/accent_coral"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_raw_log_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raw Logger: IDLE • 0 samples"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATASET PROTOCOL TAGS (TAP WHILE DRIVING):"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_tag_stat_off"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="STAT OFF"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_stat_on"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="STAT ON"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_cruise_20"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="CRUISE 20"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_cruise_40"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="CRUISE 40"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_cruise_60"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="CRUISE 60"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_accel"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="ACCEL"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_brake"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="BRAKE"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_turn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="TURN"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_bump"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="BUMP"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/card_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_tag_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="NORMAL"
                        android:textSize="10sp"
                        android:textColor="@color/accent_green"
                        android:background="@drawable/card_bg" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
